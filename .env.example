# Cloudflare Web Analytics beacon token. Public client-side ID (safe to ship).
# Get it from Cloudflare → Analytics → Web Analytics → site → JS snippet.
# Leave unset to disable analytics. NEXT_PUBLIC_* is baked at build time.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Notion. Only needed to run `pnpm sync:notion` or `pnpm migrate:to-notion`
# locally; the site itself builds and runs without any of these.
# NOTION_TOKEN is a secret — never commit a filled-in copy of this file.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Optional. A Notion database is a container and its rows live in a data
# source; an ordinary database has exactly one, which both commands resolve
# from NOTION_DATABASE_ID. Set this only if the database exposes more than one —
# the run stops and names them rather than picking whichever came back first.
# It is checked against NOTION_DATABASE_ID before anything is read.
NOTION_DATA_SOURCE_ID=
